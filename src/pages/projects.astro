---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getPosts } from '../lib/posts';
const showTypographyProject = (await getPosts()).some(post => post.id === 'between-two-scripts');
---
<BaseLayout title="Projects" description="工作台上的小东西：个人网站与中西混排实验。" wide>
  <header class="page-heading">
    <p class="eyebrow label" lang="en">Notes from the workbench</p>
    <h1 lang="en">Things, made slowly.</h1>
    <p>从一个小想法开始，做一点，再改一点。</p>
  </header>
  <div class="projects">
    <ProjectCard number="01" title="A home on the web" year={2026}
      summary="就是你正在读的这个网站。Astro、Markdown 与手写 CSS，把个人写作装进一张温暖的纸里。"
      url="/" repo="https://github.com/yuanlx27/yuanlx27.github.io" />
    {showTypographyProject && <ProjectCard number="02" title="Between two scripts" year={2026}
      summary="这个网站的排版试样。让京华老宋体与 IM Fell English 坐在同一行，试试中文、英文、代码与注脚怎样相处。"
      url="/blog/between-two-scripts/" />}
  </div>
  <p class="worknote" lang="en">A small workbench. Room for whatever comes next.</p>
</BaseLayout>
<style>
  .page-heading { max-width: 42rem; margin-inline: auto; }
  .projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); }
  .worknote { text-align: center; color: var(--ink-soft); font-style: italic; font-size: 1rem; margin: var(--space-5) 0 0; }
  @media (max-width: 640px) { .projects { grid-template-columns: 1fr; } }
</style>
