---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';
---
<footer class="shell" lang="en">
  <div class="footer-line">
    <span>© {new Date().getUTCFullYear()} {site.name}</span>
    <div><a href={site.github} rel="me">GitHub</a><span aria-hidden="true"> · </span><a href="/rss.xml">RSS feed</a></div>
  </div>
  <p class="colophon">Set in IM Fell English &amp; KingHwa Old Song.<br />A little corner of the web, printed in pixels.</p>
  <ThemeToggle />
</footer>

<style>
  footer { border-top: 3px double var(--rule); padding-block: var(--space-3) var(--space-5); color: var(--ink-soft); }
  .footer-line { display: flex; flex-wrap: wrap; justify-content: space-between; column-gap: var(--space-2); font-size: .85rem; }
  .footer-line a { display: inline-block; padding-block: .3rem; }
  .colophon { text-align: center; font-style: italic; font-size: .85rem; line-height: 1.6; margin: var(--space-3) 0 var(--space-2); }
</style>
